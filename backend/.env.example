# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# ─────────────────────────────────────────────────────────── core
DATABASE_URL="postgresql://user:password@localhost:5432/ipm_lots"
PORT=4000
# Set to "production" on the server. It switches CORS from "reflect any origin"
# to the FRONTEND_URL allowlist and makes the session cookie Secure. Leaving it
# unset in production means an open API and a cookie that works over plain http.
NODE_ENV=development

# Comma-separated origins allowed to call the API when NODE_ENV=production.
# Not needed when Nginx serves the UI and API on one origin (the recommended setup).
FRONTEND_URL=https://ipm.example.com

# Set to "false" only if the app is NOT behind a reverse proxy. When true,
# Express reads the client IP from X-Forwarded-For.
# TRUST_PROXY=true

# ─────────────────────────────────────────────────────────── authentication
# Who may sign in. Comma-separated. This is the access control list —
# removing an address here revokes it on the next request, not on session expiry.
AUTH_ALLOWED_EMAILS=spices@sumanexport.in,connect@sumanexport.in,export@sumanexport.in

# Where sign-in notices are sent. Leave empty to disable them.
AUTH_NOTIFY_EMAIL=spices@sumanexport.in

# Defaults shown; override only with a reason.
# AUTH_CODE_TTL_SECONDS=600
# AUTH_RESEND_GAP_SECONDS=60
# AUTH_MAX_ATTEMPTS=5
# AUTH_SESSION_DAYS=30

# ─────────────────────────────────────────────────────────── storage
# Lab-report PDFs. In production point this OUTSIDE the checkout, or a deploy
# that replaces the working directory destroys the evidence behind past
# compliance decisions.
UPLOADS_DIR=/var/ipm/uploads

# Optional S3 instead of local disk
# STORAGE_MODE=s3
# AWS_S3_BUCKET_NAME=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────── integrations
OPENAI_API_KEY=sk-...

# Gmail. Either place credentials.json and token.json next to dist/, or paste
# their contents here as single-line JSON (preferred on a server).
# GMAIL_CREDENTIALS_JSON={"installed":{...}}
# GMAIL_TOKEN_JSON={"access_token":"...","refresh_token":"..."}
# PROCESSED_GMAIL_LABEL=processed
# TRACKED_EMAIL_LIMIT=10

# Redis, for the BullMQ worker (a separate process from the API)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────── tuning
# OPENAI_MAX_ATTACHMENT_CHARS=45000
# OPENAI_SECTION_CONCURRENCY=10
# BACKEND_LOG_FILE=./backend-debug.log
